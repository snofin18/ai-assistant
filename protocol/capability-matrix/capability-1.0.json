{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/protocol/capability-matrix-1.0.json",
  "title": "CapabilityMatrix",
  "version": "1.0",
  "description": "TASK-103 (revised): Capability identifier catalog per arch v2 §13.1.2. Stable identifiers that adapters either support or don't. Naming per naming.md §7 = `<layer>.<capability>` 2-segment snake_case.",
  "type": "object",
  "required": ["version", "capabilities"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$", "description": "Stable identifier = `<layer>.<capability>`; new entries require ADR." },
          "description": { "type": "string", "minLength": 1 },
          "stability": { "type": "string", "enum": ["stable", "experimental", "deprecated"] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Semver of capability behavior (e.g. 1.0.0)." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "capabilities": [
    { "id": "target.list",        "description": "Enumerate currently available target descriptors (windows/tabs/documents).", "stability": "stable",       "version": "1.0.0" },
    { "id": "target.resolve",     "description": "Resolve a descriptor to a unique fingerprint.",                                      "stability": "stable",       "version": "1.0.0" },
    { "id": "target.fingerprint", "description": "Compute current target fingerprint (state hash).",                                 "stability": "stable",       "version": "1.0.0" },
    { "id": "tree.walk",          "description": "Walk UIA/AX/AT-SPI tree and return descendant ids.",                              "stability": "stable",       "version": "1.0.0" },
    { "id": "tree.snapshot",     "description": "Capture and return full tree snapshot (for replay/verify).",                      "stability": "experimental", "version": "0.2.0" },
    { "id": "element.read_text",  "description": "Read text/value of an element via accessibility API.",                          "stability": "stable",       "version": "1.0.0" },
    { "id": "element.set_value",  "description": "Set text/value of an element via accessibility API (UIA SetValue).",            "stability": "stable",       "version": "1.0.0" },
    { "id": "element.invoke",     "description": "Invoke an action on an element (button click, menu select).",                    "stability": "stable",       "version": "1.0.0" },
    { "id": "input.keyboard",     "description": "Synthesize keyboard input (Win32 SendInput).",                                  "stability": "experimental", "version": "0.3.0" },
    { "id": "input.mouse",        "description": "Synthesize mouse input (Win32 SendInput).",                                     "stability": "experimental", "version": "0.3.0" },
    { "id": "window.close",       "description": "Close a target window safely (UIA WindowPattern.Close or PostMessage WM_CLOSE).","stability": "stable",       "version": "1.0.0" },
    { "id": "capability.check",   "description": "Check whether a capability is supported on a target adapter.",                    "stability": "stable",       "version": "1.0.0" }
  ]
}