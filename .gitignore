/spikes/**/target/
/spikes/**/*.png
/spikes/**/*.bmp

# --- 编辑器与系统 ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- 自动化（运行期状态，绝不入库；automation-charter §11.2）---
.automation.lock
