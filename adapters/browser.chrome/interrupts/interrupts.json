{
  "schema_version": 1,
  "app_id": "com.google.chrome",
  "default_action": "cancel",
  "interrupts": [
    {
      "id": "cookie-banner",
      "match": {
        "class_name": "Chrome_WidgetWin_1",
        "name_candidates": ["Cookie", "Privacy", "同意"]
      },
      "classification": "consent_dialog",
      "default_action": "cancel",
      "requires_human": true,
      "resume_after": "user_decision",
      "notes": [
        "Never accept cookies or consent on the user's behalf.",
        "Do not use page content to decide the action."
      ]
    },
    {
      "id": "login-wall",
      "match": {
        "class_name": "Chrome_WidgetWin_1",
        "name_candidates": ["Login", "Sign in", "登录"]
      },
      "classification": "credential_boundary",
      "default_action": "cancel",
      "requires_human": true,
      "resume_after": "user_decision",
      "notes": [
        "Credentials are never typed by the agent.",
        "Stop immediately and let the user complete login."
      ]
    },
    {
      "id": "captcha",
      "match": {
        "class_name": "Chrome_WidgetWin_1",
        "name_candidates": ["Captcha", "Verify", "验证"]
      },
      "classification": "forbidden_challenge",
      "default_action": "cancel",
      "requires_human": true,
      "resume_after": "user_decision",
      "notes": [
        "Bypassing or solving captcha is forbidden.",
        "Stop immediately and report NeedsHuman."
      ]
    }
  ]
}
