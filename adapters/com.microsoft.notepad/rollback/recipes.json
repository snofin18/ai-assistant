{
  "schema_version": 1,
  "app_id": "com.microsoft.notepad",
  "recipes": [
    {
      "tool": "notepad.file.replace_text",
      "coverage": "recipe",
      "anchor_strategy": [
        {
          "level": "l0",
          "mechanism": "undo_stack",
          "capture": {
            "kind": "undo_budget",
            "source": "builtin:app.undo_stack",
            "max_steps": 1,
            "valid_until": "document_close",
            "observations": ["canonical_text", "whole_window_fingerprint"]
          },
          "restore": {
            "kind": "undo_stack",
            "times": 1,
            "until": "captured_pre_fingerprint"
          },
          "post_verify": {
            "kind": "capture_equals",
            "observation": "canonical_text"
          }
        },
        {
          "level": "l1",
          "mechanism": "content_snapshot",
          "capture": {
            "kind": "content_snapshot",
            "source": "builtin:storage.content_snapshot",
            "observations": ["canonical_text", "whole_window_fingerprint"]
          },
          "restore": {
            "kind": "restore_content_snapshot"
          },
          "post_verify": {
            "kind": "capture_equals",
            "observation": "canonical_text"
          }
        }
      ],
      "on_rollback_failure": "publish_incident_and_require_human"
    },
    {
      "tool": "notepad.file.save",
      "coverage": "recipe",
      "anchor_strategy": [
        {
          "level": "l1",
          "mechanism": "shadow_copy",
          "capture": {
            "kind": "file_shadow_copy",
            "source": "builtin:filesystem.shadow_copy",
            "observations": ["file_digest", "whole_window_fingerprint"]
          },
          "restore": {
            "kind": "restore_file_shadow_copy"
          },
          "post_verify": {
            "kind": "capture_equals",
            "observation": "file_digest"
          }
        }
      ],
      "on_rollback_failure": "publish_incident_and_require_human"
    },
    {
      "tool": "notepad.file.save_as",
      "coverage": "no_recovery",
      "reason": "Save As creates or replaces a user-selected external file and requires explicit human review; it must never auto-save, overwrite, or delete the target during rollback.",
      "on_rollback_failure": "publish_incident_and_require_human"
    },
    {
      "tool": "notepad.tab.new",
      "coverage": "recipe",
      "anchor_strategy": [
        {
          "level": "l2",
          "mechanism": "compensating_action",
          "capture": {
            "kind": "compensating_state",
            "source": "tool:notepad.file.read_text",
            "observations": ["whole_window_fingerprint"]
          },
          "restore": {
            "kind": "close_created_target",
            "target_kind": "tab",
            "require_empty": true
          },
          "post_verify": {
            "kind": "capture_equals",
            "observation": "whole_window_fingerprint"
          }
        }
      ],
      "on_rollback_failure": "publish_incident_and_require_human"
    }
  ]
}
