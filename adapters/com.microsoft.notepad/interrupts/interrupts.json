{
  "schema_version": 1,
  "app_id": "com.microsoft.notepad",
  "default_action": "cancel",
  "interrupts": [
    {
      "id": "unsaved-changes-dialog",
      "priority": 300,
      "match": {
        "class_name": "#32770",
        "title_candidates": [
          {"value": "保存更改", "locale_dependent": true},
          {"value": "Save changes", "locale_dependent": true}
        ]
      },
      "action": {"kind": "ask_human"},
      "classification": "unsaved_changes_three_way",
      "requires_human": true,
      "resume_after": "user_decision",
      "notes": [
        "Never choose Save, Don't Save, or Cancel on the user's behalf.",
        "Dialog button labels remain application-owned text and are not selectors."
      ]
    },
    {
      "id": "save-as-dialog",
      "priority": 200,
      "match": {
        "class_name": "#32770",
        "title_candidates": [
          {"value": "另存为", "locale_dependent": true},
          {"value": "Save As", "locale_dependent": true}
        ]
      },
      "action": {"kind": "delegate_to_tool", "tool": "notepad.file.save_as"},
      "classification": "cross_process_shell_dialog",
      "requires_human": true,
      "resume_after": "tool_resume",
      "notes": [
        "The dialog belongs to an explorer.exe child process.",
        "Never overwrite an existing file without explicit backup and confirmation."
      ]
    },
    {
      "id": "transient-teaching-tip",
      "priority": 100,
      "match": {
        "automation_id_candidates": [
          "PrivacyTeachingTip",
          "PsDownloadDetailTeachingTip",
          "PsDownloadLightTeachingTip"
        ],
        "class_name_contains": "TeachingTip"
      },
      "action": {"kind": "dismiss_explicitly"},
      "classification": "transient_popup",
      "requires_human": false,
      "notes": [
        "ADR-0022 D9 requires explicit dismissal or explicit tolerance.",
        "Fixed sleeps and wait-until-disappears are forbidden."
      ]
    }
  ]
}
