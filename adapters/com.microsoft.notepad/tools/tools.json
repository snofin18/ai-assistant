{
  "schema_version": 1,
  "app_id": "com.microsoft.notepad",
  "tools": [
    {
      "schema": {
        "version": "1.1",
        "name": "notepad.file.read_text",
        "description": "Read the active Notepad document through UIA and return canonical LF text.",
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "text",
            "truncated"
          ],
          "additionalProperties": false
        },
        "effect": "read",
        "reversibility": "none_readonly",
        "risk_level": "low",
        "requires_approval": false,
        "idempotent": true,
        "tags": [
          "notepad",
          "text",
          "read"
        ]
      },
      "capabilities": [
        "element.read_text",
        "target.resolve"
      ],
      "postconditions": [
        {
          "kind": "state_unchanged",
          "fingerprint_scope": "whole_window",
          "description": "Reading the document does not change the target.",
          "error_code": "VerifyFailed"
        }
      ]
    },
    {
      "schema": {
        "version": "1.1",
        "name": "notepad.file.replace_text",
        "description": "Replace all literal occurrences in the active document and verify the resulting text.",
        "input": {
          "type": "object",
          "properties": {
            "old_text": {
              "type": "string",
              "minLength": 1
            },
            "new_text": {
              "type": "string"
            },
            "expected_replacements": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "old_text",
            "new_text",
            "expected_replacements"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "replacement_count": {
              "type": "integer"
            },
            "canonical_text": {
              "type": "string"
            }
          },
          "required": [
            "replacement_count",
            "canonical_text"
          ],
          "additionalProperties": false
        },
        "effect": "write",
        "reversibility": "l1_snapshot",
        "risk_level": "medium",
        "requires_approval": true,
        "idempotent": false,
        "tags": [
          "notepad",
          "text",
          "replace"
        ]
      },
      "capabilities": [
        "element.set_value",
        "target.resolve"
      ],
      "postconditions": [
        {
          "kind": "state_changed",
          "within_ms": 3000,
          "description": "Replacing the document content changes the target.",
          "error_code": "VerifyFailed"
        }
      ]
    },
    {
      "schema": {
        "version": "1.1",
        "name": "notepad.file.save",
        "description": "Save the active document and verify that the unsaved marker is gone.",
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "saved": {
              "type": "boolean"
            },
            "window_title": {
              "type": "string"
            }
          },
          "required": [
            "saved",
            "window_title"
          ],
          "additionalProperties": false
        },
        "effect": "write",
        "reversibility": "l1_snapshot",
        "risk_level": "high",
        "requires_approval": true,
        "idempotent": false,
        "tags": [
          "notepad",
          "file",
          "save"
        ]
      },
      "capabilities": [
        "input.keyboard",
        "target.resolve"
      ],
      "postconditions": [
        {
          "kind": "state_changed",
          "within_ms": 3000,
          "description": "Saving removes the unsaved marker and changes the target state.",
          "error_code": "VerifyFailed"
        }
      ]
    },
    {
      "schema": {
        "version": "1.1",
        "name": "notepad.tab.new",
        "description": "Create a new empty Notepad tab.",
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "tab_count": {
              "type": "integer"
            }
          },
          "required": [
            "tab_count"
          ],
          "additionalProperties": false
        },
        "effect": "write",
        "reversibility": "l1_snapshot",
        "risk_level": "low",
        "requires_approval": false,
        "idempotent": false,
        "tags": [
          "notepad",
          "tab",
          "new"
        ]
      },
      "capabilities": [
        "input.keyboard",
        "target.resolve"
      ],
      "postconditions": [
        {
          "kind": "state_changed",
          "within_ms": 3000,
          "description": "Creating a tab changes the window content.",
          "error_code": "VerifyFailed"
        }
      ]
    },
    {
      "schema": {
        "version": "1.1",
        "name": "notepad.file.save_as",
        "description": "Save the active document to a new path without silently overwriting an existing file.",
        "input": {
          "type": "object",
          "properties": {
            "target_path": {
              "type": "string",
              "minLength": 1
            },
            "overwrite_existing": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "target_path",
            "overwrite_existing"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "target_path": {
              "type": "string"
            },
            "file_created": {
              "type": "boolean"
            }
          },
          "required": [
            "target_path",
            "file_created"
          ],
          "additionalProperties": false
        },
        "effect": "write",
        "reversibility": "l3_irreversible",
        "risk_level": "high",
        "requires_approval": true,
        "idempotent": false,
        "tags": [
          "notepad",
          "file",
          "save_as"
        ]
      },
      "capabilities": [
        "element.invoke",
        "input.keyboard",
        "target.resolve"
      ],
      "postconditions": [
        {
          "kind": "file_changed",
          "path": "{{target_path}}",
          "expect": "digest",
          "description": "The requested Save As target exists with a file digest.",
          "error_code": "VerifyFailed"
        }
      ]
    }
  ]
}
